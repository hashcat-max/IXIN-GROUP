/* IXIN OS — Calamares : zone principale claire (lisible), barre latérale noire/émeraude via branding.desc */
QPushButton { border-radius: 6px; padding: 6px 14px; }
QProgressBar { border: 1px solid #1c6bff; border-radius: 4px; text-align: center; }
QProgressBar::chunk { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #19f3a4, stop:0.6 #1c6bff, stop:1 #a855f7); border-radius: 3px; }
