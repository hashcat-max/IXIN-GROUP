#!/usr/bin/env bash
# Lance l'installeur graphique IXIN OS (Calamares)
if [[ $EUID -ne 0 ]]; then
    exec pkexec env DISPLAY="$DISPLAY" WAYLAND_DISPLAY="$WAYLAND_DISPLAY" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
        QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}" XAUTHORITY="$XAUTHORITY" "$0" "$@"
fi
exec calamares "$@"
