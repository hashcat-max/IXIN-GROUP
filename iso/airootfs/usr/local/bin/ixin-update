#!/usr/bin/env bash
# Mise à jour complète : dépôts officiels + Chaotic-AUR + Flatpak + firmwares
set -e
echo -e "\e[38;2;25;243;164m▶ Mise à jour du système IXIN OS\e[0m"
sudo pacman -Syu
command -v flatpak >/dev/null && flatpak update -y || true
command -v fwupdmgr >/dev/null && { fwupdmgr refresh --force >/dev/null 2>&1 || true; fwupdmgr get-updates || true; }
echo -e "\e[38;2;25;243;164m▶ Vulnérabilités connues dans les paquets installés :\e[0m"
arch-audit -u || true
read -rp "Appuyez sur Entrée pour fermer…"
