+/// IXIN OS : système live démarré par IXIN OS Setup (installation lancée depuis Windows) ?
+static bool
+ixinSetupFromWindows()
+{
+    QFile cmdline( QStringLiteral( "/proc/cmdline" ) );
+    if ( !cmdline.open( QIODevice::ReadOnly ) )
+    {
+        return false;
+    }
+    return cmdline.readAll().simplified().split( ' ' ).contains( QByteArrayLiteral( "ixin.setup=windows" ) );
+}
