 void
+ChoicePage::ixinSelectPreparedSpace()
+{
+    if ( m_ixinSpaceSelected || !ixinFromWindows() || m_config->installChoice() != InstallChoice::Replace
+         || !m_beforePartitionBarsView || !m_beforePartitionBarsView->selectionModel()
+         || m_beforePartitionBarsView->selectionModel()->currentIndex().isValid() )
+    {
+        return;
+    }
+    const QModelIndex prepared = ixinPreparedFreeSpace( m_beforePartitionBarsView->model() );
+    if ( prepared.isValid() )
+    {
+        cDebug() << "IXIN OS : espace libre préparé par IXIN OS Setup présélectionné";
+        m_ixinSpaceSelected = true;
+        m_beforePartitionBarsView->selectionModel()->setCurrentIndex( prepared, QItemSelectionModel::Select );
+    }
+}
