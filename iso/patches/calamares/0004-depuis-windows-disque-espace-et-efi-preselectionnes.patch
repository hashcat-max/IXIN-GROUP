+// ── IXIN OS : installation lancée depuis Windows par IXIN OS Setup ─────────────
+//
+// IXIN OS Setup a préparé sous Windows une partition « IXIN-SETUP » (l'ISO) suivie de l'espace
+// libre pour IXIN OS, et transmet par la ligne de commande du noyau la partition EFI à utiliser
+// (ixin.esp=PARTUUID). Ce disque, cet espace et cette partition EFI sont présélectionnés.
+
+/// Valeur d'une option du noyau (« ixin.esp=… »), vide si absente.
+static QString
+ixinKernelOption( const QString& name )
+{
+    QFile cmdline( QStringLiteral( "/proc/cmdline" ) );
+    if ( !cmdline.open( QIODevice::ReadOnly ) )
+    {
+        return QString();
+    }
+    const QString prefix = name + QLatin1Char( '=' );
+    const QStringList words = QString::fromUtf8( cmdline.readAll() ).simplified().split( QLatin1Char( ' ' ) );
+    for ( const QString& word : words )
+    {
+        if ( word.startsWith( prefix ) )
+        {
+            return word.mid( prefix.length() );
+        }
+    }
+    return QString();
+}
+
+static bool
+ixinFromWindows()
+{
+    return ixinKernelOption( QStringLiteral( "ixin.setup" ) ) == QStringLiteral( "windows" );
+}
+
+/// La partition IXIN-SETUP, reconnue à son étiquette (lue par kpmcore ou par udev).
+static bool
+ixinIsSetupPartition( const Partition* partition )
+{
+    if ( !partition || isPartitionFreeSpace( partition ) )
+    {
+        return false;
+    }
+    static const QString byLabel
+        = QFileInfo( QStringLiteral( "/dev/disk/by-label/IXIN-SETUP" ) ).canonicalFilePath();
+    return partition->fileSystem().label() == QStringLiteral( "IXIN-SETUP" )
+        || ( !byLabel.isEmpty() && partition->partitionPath() == byLabel );
+}
+
+static bool
+ixinHasSetupPartition( Device* device )
+{
+    if ( !device || !device->partitionTable() )
+    {
+        return false;
+    }
+    for ( auto it = PartitionIterator::begin( device ); it != PartitionIterator::end( device ); ++it )
+    {
+        if ( ixinIsSetupPartition( *it ) )
+        {
+            return true;
+        }
+    }
+    return false;
+}
+
+/// L'espace libre préparé : la plus grande zone libre après IXIN-SETUP (une partition EFI créée
+/// par IXIN OS Setup peut les séparer), à défaut la plus grande zone libre du disque.
+static QModelIndex
+ixinPreparedFreeSpace( QAbstractItemModel* model )
+{
+    auto* partitions = qobject_cast< PartitionModel* >( model );
+    if ( !partitions )
+    {
+        return QModelIndex();
+    }
+    qint64 setupEnd = -1;
+    for ( int row = 0; row < partitions->rowCount(); ++row )
+    {
+        const Partition* p = partitions->partitionForIndex( partitions->index( row, 0 ) );
+        if ( ixinIsSetupPartition( p ) )
+        {
+            setupEnd = p->lastSector();
+        }
+    }
+    QModelIndex afterSetup, anywhere;
+    qint64 afterSize = 0, anySize = 0;
+    for ( int row = 0; row < partitions->rowCount(); ++row )
+    {
+        const QModelIndex index = partitions->index( row, 0 );
+        const Partition* p = partitions->partitionForIndex( index );
+        if ( !p || !isPartitionFreeSpace( p ) )
+        {
+            continue;
+        }
+        if ( p->capacity() > anySize )
+        {
+            anySize = p->capacity();
+            anywhere = index;
+        }
+        if ( setupEnd >= 0 && p->firstSector() > setupEnd && p->capacity() > afterSize )
+        {
+            afterSize = p->capacity();
+            afterSetup = index;
+        }
+    }
+    return afterSetup.isValid() ? afterSetup : anywhere;
+}
