<Project Sdk="Microsoft.NET.Sdk">
  <!-- IXIN OS Setup : installe IXIN OS à côté de Windows (programme Windows, .NET Framework 4.6.2 :
       présent d'origine sur toutes les versions de Windows 10 depuis 2016 (1607, LTSB 2016) et sur Windows 11,
       un seul fichier .exe, rien d'autre à installer).
       AnyCPU sans préférence 32 bits : 64 bits sur un Windows 64 bits (seul cas pris en charge) ; il démarre
       aussi sur un Windows 32 bits ou ARM pour y expliquer clairement que ce PC ne convient pas. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>IXIN-OS-Setup</AssemblyName>
    <RootNamespace>IxinSetup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ixin.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>IXIN OS Setup</Product>
    <Company>IXIN Group</Company>
    <Copyright>IXIN Group</Copyright>
    <Description>Installe IXIN OS à côté de Windows</Description>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Chargeur de démarrage de l'installation (tools/build-windows-boot.sh) -->
    <GrubEfi Condition="'$(GrubEfi)' == ''">$(MSBuildThisFileDirectory)..\..\build\windows-boot\grubx64.efi</GrubEfi>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compilation possible hors de Windows ; à l'exécution, PowerShell 5.1 de Windows est utilisé -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.PowerShell.5.1.ReferenceAssemblies" Version="1.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(GrubEfi)" LogicalName="grubx64.efi" />
    <!-- Secure Boot (construction avec la clé IXIN) : shim, MokManager et certificat, à côté du chargeur -->
    <EmbeddedResource Include="$([System.IO.Path]::GetDirectoryName($(GrubEfi)))\shimx64.efi" LogicalName="shimx64.efi" Condition="Exists('$([System.IO.Path]::GetDirectoryName($(GrubEfi)))\shimx64.efi')" />
    <EmbeddedResource Include="$([System.IO.Path]::GetDirectoryName($(GrubEfi)))\mmx64.efi" LogicalName="mmx64.efi" Condition="Exists('$([System.IO.Path]::GetDirectoryName($(GrubEfi)))\mmx64.efi')" />
    <EmbeddedResource Include="$([System.IO.Path]::GetDirectoryName($(GrubEfi)))\ixin-secureboot.cer" LogicalName="ixin-secureboot.cer" Condition="Exists('$([System.IO.Path]::GetDirectoryName($(GrubEfi)))\ixin-secureboot.cer')" />
    <EmbeddedResource Include="Assets\ixin-logo-64.png" LogicalName="ixin-logo-64.png" />
    <EmbeddedResource Include="Assets\ixin.ico" LogicalName="ixin.ico" />
  </ItemGroup>

  <Target Name="CheckGrubEfi" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(GrubEfi)')" Text="grubx64.efi introuvable ($(GrubEfi)) : lancez d'abord tools/build-windows-boot.sh" />
  </Target>
</Project>
