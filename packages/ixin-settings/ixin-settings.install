# Copies laissées par la première bêta d'IXIN OS (fichiers non gérés par pacman).
_legacy=(
  etc/sysctl.d/80-ixin-performance.conf
  etc/sysctl.d/90-ixin-hardening.conf
  etc/NetworkManager/conf.d/20-ixin-privacy.conf
  etc/systemd/resolved.conf.d/20-ixin-dns.conf
  etc/systemd/zram-generator.conf

  etc/sddm.conf.d/10-ixin.conf
  etc/pacman.d/hooks/90-ixin-branding.hook
  usr/local/bin/ixin-branding
)

_cleanup_legacy() {
  local f
  for f in "${_legacy[@]}"; do
    if [ -e "$f" ] && ! usr/bin/pacman -Qqo "/$f" >/dev/null 2>&1; then
      rm -f "$f"
    fi
  done
}

_apply_now() {
  # Appliquer les réglages tout de suite sur un système démarré (jamais pendant la
  # construction de l'ISO ni dans un chroot : sysctl modifierait la machine hôte).
  [ -d run/systemd/system ] || return 0
  usr/bin/systemd-detect-virt --chroot >/dev/null 2>&1 && return 0
  [ -d run/archiso ] && return 0
  usr/bin/sysctl --system >/dev/null 2>&1 || true
  usr/bin/systemctl try-restart systemd-resolved.service >/dev/null 2>&1 || true
  usr/bin/systemctl try-reload-or-restart NetworkManager.service >/dev/null 2>&1 || true
}

post_install() {
  usr/lib/ixin/ixin-branding
  _cleanup_legacy
  _apply_now
}

post_upgrade() {
  post_install
}
