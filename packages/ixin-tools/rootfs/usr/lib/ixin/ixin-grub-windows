#!/bin/sh
# IXIN OS — entrée « Windows » du menu de démarrage (GRUB)
#
# Windows démarre par sa propre entrée du firmware (BootNext, puis redémarrage) : exactement comme sans IXIN, si bien que BitLocker
# ne demande pas sa clé de récupération — ce qu'il fait souvent quand GRUB lance lui-même le
# chargeur de Windows. Sans entrée du firmware, GRUB lance Windows directement.
#
#   --menu        l'entrée du menu (appelé par /etc/grub.d/26_ixin_windows)
#   --uuid        identifiant de la partition EFI de Windows (entrée GRUB « ixin-windows-<uuid> »)
#   --bootnum     numéro de l'entrée « Windows » du firmware (UEFI), s'il y en a une
#   --skip-list   ce Windows, pour qu'os-prober ne l'ajoute pas une seconde fois
#                 (/etc/default/grub.d/ixin-windows.cfg)
#
# Windows est cherché dans la partition EFI d'IXIN OS, puis dans les autres partitions EFI du PC :
# partition EFI dédiée créée par IXIN OS Setup, ou partition de Windows sur un autre disque.
set -u
LOADER=/EFI/Microsoft/Boot/bootmgfw.efi
ESP_TYPE=c12a7328-f81f-11d2-ba4b-00a0c93ec93b

# 1. Partition EFI montée contenant le chargeur de Windows (vfat : noms insensibles à la casse)
dev=""
for mp in /boot/efi /efi /boot; do
    [ "$(findmnt -no FSTYPE --mountpoint "$mp" 2>/dev/null)" = vfat ] || continue
    [ -f "$mp$LOADER" ] || continue
    dev="$(findmnt -no SOURCE --mountpoint "$mp")"
    break
done
# 2. Sinon les autres partitions EFI, montées en lecture seule le temps de vérifier
if [ -z "$dev" ]; then
    for cand in $(lsblk -rpno NAME,PARTTYPE 2>/dev/null | awk -v t="$ESP_TYPE" 'tolower($2) == t { print $1 }'); do
        mp="$(findmnt -no TARGET --source "$cand" 2>/dev/null | head -n 1)"
        if [ -n "$mp" ]; then
            [ -f "$mp$LOADER" ] && dev="$cand"
        elif tmp="$(mktemp -d 2>/dev/null)"; then
            if mount -o ro,nosuid,nodev,noexec -t vfat "$cand" "$tmp" 2>/dev/null; then
                [ -f "$tmp$LOADER" ] && dev="$cand"
                umount "$tmp"
            fi
            rmdir "$tmp"
        fi
        [ -n "$dev" ] && break
    done
fi
[ -b "$dev" ] || exit 0
uuid="$(blkid -s UUID -o value "$dev" 2>/dev/null)"
[ -n "$uuid" ] || exit 0

# Windows trouvé : noté pour « Jouer sous Windows » (ixin-windows), lisible sans droits
if [ "${1:-}" = --menu ] && [ -d /var/lib ]; then
    mkdir -p /var/lib/ixin 2>/dev/null &&
        printf 'uuid=%s\n' "$uuid" > /var/lib/ixin/windows 2>/dev/null &&
        chmod 644 /var/lib/ixin/windows 2>/dev/null
fi

case "${1:-}" in
--uuid)
    echo "$uuid"
    ;;
--bootnum)
    # Entrée « Windows Boot Manager » du firmware (UEFI), pour démarrer Windows une seule fois
    [ -d /sys/firmware/efi ] || exit 1
    partuuid="$(blkid -s PARTUUID -o value "$dev" 2>/dev/null | tr 'A-Z' 'a-z')"
    num="$(efibootmgr -v 2>/dev/null | tr 'A-Z\\' 'a-z/' |
        sed -n "s|^boot\([0-9a-f]\{4\}\)\*\{0,1\} .*gpt,$partuuid,.*/efi/microsoft/boot/bootmgfw\.efi.*|\1|p" | head -n 1)"
    [ -n "$num" ] || exit 1
    echo "$num"
    ;;
--skip-list)
    echo "$uuid@$LOADER"
    ;;
--menu)
    [ -d /sys/firmware/efi ] || exit 0
    partuuid="$(blkid -s PARTUUID -o value "$dev" 2>/dev/null | tr 'A-Z' 'a-z')"
    num=""
    if [ -n "$partuuid" ] && command -v efibootmgr >/dev/null 2>&1; then
        # Le chemin s'affiche « \EFI\... » ou « File(\EFI\...) » selon la version d'efibootmgr
        num="$(efibootmgr -v 2>/dev/null | tr 'A-Z\\' 'a-z/' |
            sed -n "s|^boot\([0-9a-f]\{4\}\)\*\{0,1\} .*gpt,$partuuid,.*/efi/microsoft/boot/bootmgfw\.efi.*|\1|p" |
            head -n 1)"
    fi
    if [ -n "$num" ]; then
        echo "IXIN : entrée « Windows » (démarrage par l'entrée Boot$num du firmware)" >&2
    else
        echo "IXIN : entrée « Windows » (lancé par GRUB)" >&2
    fi
    cat <<GRUB
menuentry 'Windows' --class windows --class os \$menuentry_id_option 'ixin-windows-$uuid' {
	insmod part_gpt
	insmod fat
GRUB
    if [ -n "$num" ]; then
        cat <<GRUB
	insmod efibootnext
	if bootnext $num; then
		reboot
	fi
GRUB
    fi
    cat <<GRUB
	search --no-floppy --fs-uuid --set=root $uuid
	chainloader $LOADER
}
GRUB
    ;;
esac
exit 0
