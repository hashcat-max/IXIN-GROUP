#!/usr/bin/env python3
"""Centre IXIN — accueil, sécurité, jeux et système pour IXIN OS."""
import json
import platform
import shutil
import subprocess
import sys
import traceback
from pathlib import Path

from PyQt6.QtCore import QFileSystemWatcher, Qt, QTimer, QUrl
from PyQt6.QtGui import QDesktopServices, QIcon, QPixmap
from PyQt6.QtWidgets import (
    QApplication, QButtonGroup, QCheckBox, QFrame, QGridLayout, QHBoxLayout, QLabel, QListWidget,
    QListWidgetItem, QMainWindow, QMessageBox, QPushButton, QRadioButton, QTabWidget, QVBoxLayout, QWidget,
)

BRAND = "/usr/share/ixin/branding"
CONF_DIR = Path.home() / ".config" / "ixin"
NO_WELCOME = CONF_DIR / "no-welcome"
IS_LIVE = Path("/run/archiso").exists()

STYLE = """
QWidget { background: #0b0c10; color: #e9ecef; font-family: Inter; font-size: 10.5pt; }
QTabWidget::pane { border: 1px solid #1a1d22; border-radius: 8px; }
QTabBar::tab { background: #111318; color: #8d9299; padding: 9px 18px; border-top-left-radius: 8px; border-top-right-radius: 8px; }
QTabBar::tab:selected { background: #050505; color: #19f3a4; }
QPushButton { background: #151820; border: 1px solid #23272f; border-radius: 8px; padding: 10px 14px; text-align: left; }
QPushButton:hover { border-color: #19f3a4; }
QPushButton:disabled { color: #5c6167; border-color: #1a1d22; }
QPushButton#primary { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #19f3a4, stop:1 #1c6bff); color: #050505; font-weight: 600; text-align: center; }
QLabel#title { font-size: 22pt; font-weight: 300; }
QLabel#sub { color: #8d9299; }
QLabel#ok { color: #22c55e; } QLabel#warn { color: #fbbf24; } QLabel#bad { color: #ef4444; }
QFrame#card { background: #111318; border: 1px solid #1f232b; border-radius: 12px; }
QLabel#big { font-size: 15pt; font-weight: 500; }
QListWidget { background: #0e1014; border: 1px solid #1f232b; border-radius: 8px; padding: 4px; }
QRadioButton { spacing: 8px; padding: 3px; }
QFrame#card QLabel, QFrame#card QRadioButton { background: transparent; }
"""
UPDATE_STATUS = Path("/var/lib/ixin-update/status.json")
UPDATE_MODES = [
    ("auto", "Automatique (recommandé)",
     "Les correctifs de sécurité s'installent tout de suite, le reste une fois par jour, "
     "avec un point de restauration avant chaque mise à jour."),
    ("notify", "Me prévenir seulement", "IXIN OS recherche les mises à jour et vous prévient ; vous choisissez quand installer."),
    ("manual", "Manuel", "Aucune action automatique (déconseillé : vous risquez de manquer des correctifs de sécurité)."),
]


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def active(unit):
    return run(["systemctl", "is-active", unit]) == "active"


def launch(*cmd):
    if shutil.which(cmd[0]):
        subprocess.Popen(list(cmd), start_new_session=True)


def terminal(cmd):
    """Exécute une commande (pouvant demander le mot de passe sudo) dans Konsole."""
    launch("konsole", "--hold", "-e", "bash", "-c", cmd)


def button(text, slot, primary=False):
    b = QPushButton(text)
    if primary:
        b.setObjectName("primary")
    b.setCursor(Qt.CursorShape.PointingHandCursor)
    b.clicked.connect(slot)
    return b


def grid(buttons, cols=2):
    w = QWidget()
    g = QGridLayout(w)
    g.setSpacing(10)
    for i, b in enumerate(buttons):
        g.addWidget(b, i // cols, i % cols)
    return w


def system_info():
    mem = 0
    try:
        with open("/proc/meminfo") as f:
            mem = int(f.readline().split()[1]) // 1024 // 1024
    except OSError:
        pass
    cpu = ""
    try:
        with open("/proc/cpuinfo") as f:
            cpu = next((l.split(":", 1)[1].strip() for l in f if l.startswith("model name")), "")
    except OSError:
        pass
    gpu = ", ".join(l.split(": ", 1)[-1] for l in run(["lspci"]).splitlines()
                    if "VGA" in l or "3D controller" in l) or "?"
    version = run(["pacman", "-Q", "ixin-desktop"]).split(" ")[-1] if not IS_LIVE else ""
    return [("Système", ("IXIN OS (live)" if IS_LIVE else "IXIN OS") + (f" — version {version}" if version else "")),
            ("Noyau", platform.release()),
            ("Processeur", cpu or platform.machine()),
            ("Carte graphique", gpu),
            ("Mémoire", f"{mem + 1} Go" if mem else "?")]


def boot_id():
    try:
        return Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    except OSError:
        return ""


def short_date(value):
    return (value or "—").replace("T", " ")[:16]


class UpdatesTab(QWidget):
    """Onglet « Mises à jour » : état d'IXIN Update, installation, mode, historique."""

    def __init__(self):
        super().__init__()
        v = QVBoxLayout(self)
        v.setContentsMargins(28, 24, 28, 24)
        h = QLabel("Mises à jour")
        h.setObjectName("title")
        v.addWidget(h)

        card = QFrame()
        card.setObjectName("card")
        c = QVBoxLayout(card)
        c.setContentsMargins(18, 14, 18, 14)
        self.state = QLabel()
        self.state.setObjectName("big")
        self.state.setWordWrap(True)
        self.details = QLabel()
        self.details.setObjectName("sub")
        self.details.setWordWrap(True)
        self.notice = QLabel()
        self.notice.setWordWrap(True)
        self.notice.setObjectName("warn")
        c.addWidget(self.state)
        c.addWidget(self.details)
        c.addWidget(self.notice)
        row = QHBoxLayout()
        self.btn_install = button("Installer maintenant", lambda: self.start("apply"), True)
        self.btn_check = button("Rechercher des mises à jour", lambda: self.start("check"))
        self.btn_reboot = button("Redémarrer maintenant", self.reboot)
        for b in (self.btn_install, self.btn_check, self.btn_reboot):
            row.addWidget(b)
        c.addLayout(row)
        v.addWidget(card)

        self.list = QListWidget()
        self.list.setMinimumHeight(110)
        v.addWidget(self.list, 1)

        mode_box = QFrame()
        mode_box.setObjectName("card")
        m = QVBoxLayout(mode_box)
        m.setContentsMargins(18, 12, 18, 12)
        title = QLabel("Installation des mises à jour")
        title.setObjectName("sub")
        m.addWidget(title)
        self.mode_group = QButtonGroup(self)
        self.mode_buttons = {}
        for key, label, desc in UPDATE_MODES:
            rb = QRadioButton(label)
            rb.setToolTip(desc)
            self.mode_group.addButton(rb)
            self.mode_buttons[key] = rb
            m.addWidget(rb)
        self.mode_desc = QLabel()
        self.mode_desc.setObjectName("sub")
        self.mode_desc.setWordWrap(True)
        m.addWidget(self.mode_desc)
        self.mode_group.buttonClicked.connect(self.mode_clicked)
        v.addWidget(mode_box)

        v.addWidget(grid([
            button("Points de restauration (Timeshift)", lambda: launch("timeshift-launcher")),
            button("Journal des mises à jour", lambda: launch("kate", "/var/log/ixin-update.log")),
        ]))
        self.current_mode = None
        self.watcher = QFileSystemWatcher(self)
        if UPDATE_STATUS.parent.is_dir():
            self.watcher.addPath(str(UPDATE_STATUS.parent))
        self.watcher.directoryChanged.connect(lambda _: self.refresh())
        self.timer = QTimer(self, interval=5000, timeout=self.refresh)
        self.timer.start()
        self.refresh()

    def start(self, what):
        subprocess.Popen(["systemctl", "start", "--no-block", f"ixin-update-{what}.service"], start_new_session=True)
        self.state.setText("Recherche…" if what == "check" else "Installation en cours…")
        QTimer.singleShot(1500, self.refresh)

    def reboot(self):
        r = subprocess.run(["dbus-send", "--session", "--type=method_call", "--dest=org.kde.LogoutPrompt",
                            "/LogoutPrompt", "org.kde.LogoutPrompt.promptReboot"], capture_output=True)
        if r.returncode != 0:
            launch("systemctl", "reboot")

    def mode_clicked(self, rb):
        mode = next(k for k, b in self.mode_buttons.items() if b is rb)
        if mode == self.current_mode:
            return
        if mode == "manual" and QMessageBox.question(
                self, "Mode manuel", "Sans mises à jour automatiques, votre PC peut rester exposé à des failles "
                "de sécurité connues. Continuer ?") != QMessageBox.StandardButton.Yes:
            self.refresh()
            return
        r = subprocess.run(["pkexec", "/usr/bin/ixin-update", "set-mode", mode], capture_output=True, text=True)
        if r.returncode != 0:
            QMessageBox.warning(self, "Mises à jour", "Le réglage n'a pas été modifié.")
        self.refresh()

    def refresh(self):
        if IS_LIVE:
            self.state.setText("Les mises à jour seront disponibles une fois IXIN OS installé.")
            for b in (self.btn_install, self.btn_check, self.btn_reboot):
                b.hide()
            for rb in self.mode_buttons.values():
                rb.setEnabled(False)
            return
        try:
            st = json.loads(UPDATE_STATUS.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            st = {}
        state = st.get("state", "idle")
        updates = st.get("updates") or []
        security = st.get("security_updates", 0)
        reboot = st.get("reboot_required") and st.get("reboot_boot_id") == boot_id()
        busy = state in ("checking", "installing")

        if not st:
            text = "Première vérification dans quelques minutes…"
        elif state == "installing":
            text = "⟳  " + st.get("message", "Installation des mises à jour…")
        elif state == "checking":
            text = "⟳  Recherche des mises à jour…"
        elif state == "error":
            text = "⚠  " + st.get("message", "Problème lors de la mise à jour")
        elif reboot:
            text = "↻  Redémarrez pour terminer l'installation des mises à jour"
        elif updates:
            text = f"{len(updates)} mise(s) à jour disponible(s)" + (f", dont {security} de sécurité" if security else "")
            if st.get("postponed"):
                text += f"\nEn attente : {st['postponed']}"
        else:
            text = "✔  Votre système est à jour"
        self.state.setText(text)
        self.state.setObjectName("big" if state != "error" else "bad")
        self.state.style().unpolish(self.state)
        self.state.style().polish(self.state)

        details = [f"Dernière recherche : {short_date(st.get('last_check'))}",
                   f"Dernière installation : {short_date(st.get('last_apply'))}"]
        if st.get("last_snapshot"):
            details.append(f"Point de restauration : {st['last_snapshot']}")
        if st.get("excluded_repos"):
            details.append("Dépôt(s) temporairement indisponible(s) : " + ", ".join(st["excluded_repos"]))
        if st.get("pacnew"):
            details.append(f"{st['pacnew']} fichier(s) de configuration à fusionner (.pacnew)")
        self.details.setText("   ·   ".join(details))
        notice = st.get("notice") or {}
        news = st.get("arch_news") or {}
        lines = []
        if notice.get("text"):
            lines.append("Annonce IXIN : " + notice["text"])
        if news.get("title"):
            lines.append(f"Annonce Arch Linux à vérifier : {news['title']}")
        if st.get("error") and state == "error":
            lines.append(st["error"][-400:])
        self.notice.setText("\n".join(lines))
        self.notice.setVisible(bool(lines))

        self.btn_install.setVisible(bool(updates) and not reboot and not busy)
        self.btn_check.setEnabled(not busy)
        self.btn_reboot.setVisible(bool(reboot))

        self.list.clear()
        for u in sorted(updates, key=lambda u: (not u.get("security"), u["name"])):
            label = f"{u['name']}   {u['old']} → {u['new']}"
            if u.get("security"):
                label = "🛡  " + label + f"   (sécurité{' : ' + u['severity'] if u.get('severity') else ''})"
            QListWidgetItem(label, self.list)
        if not updates:
            for entry in (st.get("history") or [])[:8]:
                ok = entry.get("result") in ("ok", "repaired")
                txt = (f"{'✔' if ok else '✘'}  {short_date(entry.get('date'))} — {entry.get('count', 0)} paquet(s)"
                       + (f", {entry['security']} correctif(s) de sécurité" if entry.get("security") else "")
                       + f"  [{entry.get('reason', '')}]")
                QListWidgetItem(txt, self.list)
            if not self.list.count():
                QListWidgetItem("Aucune mise à jour installée pour le moment.", self.list)

        mode = st.get("mode") or "auto"
        self.current_mode = mode
        if mode in self.mode_buttons:
            self.mode_buttons[mode].setChecked(True)
        self.mode_desc.setText(next(d for k, _, d in UPDATE_MODES if k == mode))


class Center(QMainWindow):
    TABS = ("home", "security", "gaming", "system", "updates")

    def __init__(self, welcome=False, tab="home"):
        super().__init__()
        self.setWindowTitle("Centre IXIN")
        self.setWindowIcon(QIcon.fromTheme("ixin", QIcon(f"{BRAND}/ixin-logo-128.png")))
        self.resize(900, 680)
        self.tabs = QTabWidget()
        self.tabs.addTab(self.home_tab(welcome), "Accueil")
        self.tabs.addTab(self.security_tab(), "Sécurité")
        self.tabs.addTab(self.gaming_tab(), "Jeux")
        self.tabs.addTab(self.system_tab(), "Système")
        self.tabs.addTab(UpdatesTab(), "Mises à jour")
        if tab in self.TABS:
            self.tabs.setCurrentIndex(self.TABS.index(tab))
        self.setCentralWidget(self.tabs)

    def show_updates(self):
        self.tabs.setCurrentIndex(self.TABS.index("updates"))

    # ── Accueil ──
    def home_tab(self, welcome):
        w = QWidget()
        v = QVBoxLayout(w)
        v.setContentsMargins(28, 24, 28, 24)
        top = QHBoxLayout()
        logo = QLabel()
        logo.setPixmap(QPixmap(f"{BRAND}/ixin-logo-128.png").scaledToHeight(
            96, Qt.TransformationMode.SmoothTransformation))
        top.addWidget(logo)
        txt = QVBoxLayout()
        t = QLabel("Bienvenue dans IXIN OS")
        t.setObjectName("title")
        s = QLabel("Sécurité · Vie privée · Performance — dans l'esprit d'IXIN.")
        s.setObjectName("sub")
        txt.addWidget(t)
        txt.addWidget(s)
        top.addLayout(txt, 1)
        v.addLayout(top)

        info = QGridLayout()
        for i, (k, val) in enumerate(system_info()):
            kl = QLabel(k)
            kl.setObjectName("sub")
            vl = QLabel(val)
            vl.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
            vl.setWordWrap(True)
            info.addWidget(kl, i, 0)
            info.addWidget(vl, i, 1)
        v.addLayout(info)
        v.addSpacing(10)

        btns = []
        if IS_LIVE:
            btns.append(button("⬇  Installer IXIN OS sur ce PC", lambda: launch("/usr/local/bin/ixin-install"), True))
        btns += [
            button("⟳  Mises à jour du système", self.show_updates),
            button("🌐  getixin.com", lambda: QDesktopServices.openUrl(QUrl("https://getixin.com"))),
            button("💬  ixin.online", lambda: QDesktopServices.openUrl(QUrl("https://ixin.online"))),
        ]
        v.addWidget(grid(btns))
        v.addStretch(1)
        if welcome or not IS_LIVE:
            cb = QCheckBox("Afficher le Centre IXIN au démarrage")
            cb.setChecked(not NO_WELCOME.exists())
            cb.toggled.connect(self.set_welcome)
            v.addWidget(cb)
        return w

    @staticmethod
    def set_welcome(on):
        CONF_DIR.mkdir(parents=True, exist_ok=True)
        if on:
            NO_WELCOME.unlink(missing_ok=True)
        else:
            NO_WELCOME.touch()

    # ── Sécurité ──
    def security_tab(self):
        w = QWidget()
        v = QVBoxLayout(w)
        v.setContentsMargins(28, 24, 28, 24)
        h = QLabel("État de sécurité")
        h.setObjectName("title")
        v.addWidget(h)
        lsm = ""
        try:
            lsm = Path("/sys/kernel/security/lsm").read_text()
        except OSError:
            pass
        checks = [
            (active("ufw"), "Pare-feu (connexions entrantes bloquées)"),
            ("apparmor" in lsm, "AppArmor (confinement des applications)"),
            ("crypt" in run(["lsblk", "-o", "TYPE"]), "Disque chiffré (LUKS)"),
            (active("systemd-resolved"), "DNS chiffré (DNS-over-TLS, Quad9)"),
            (active("opensnitchd"), "Pare-feu applicatif OpenSnitch (optionnel)"),
            (active("usbguard"), "USBGuard — blocage des clés USB inconnues (optionnel)"),
        ]
        for ok, label in checks:
            l = QLabel(("✔  " if ok else "•  ") + label)
            l.setObjectName("ok" if ok else "warn")
            v.addWidget(l)
        v.addSpacing(12)
        v.addWidget(grid([
            button("Activer le pare-feu", lambda: terminal("ixin-secure firewall-on")),
            button("Activer OpenSnitch (pare-feu applicatif)", lambda: terminal("ixin-secure opensnitch-on")),
            button("Activer USBGuard", lambda: terminal("ixin-secure usbguard-on")),
            button("Activer le service Tor", lambda: terminal("ixin-secure tor-on")),
            button("Navigateur Tor", lambda: launch("torbrowser-launcher")),
            button("Coffre-fort de mots de passe (KeePassXC)", lambda: launch("keepassxc")),
            button("Conteneurs chiffrés (VeraCrypt)", lambda: launch("veracrypt")),
            button("Nettoyer les métadonnées de fichiers", lambda: launch("metadata-cleaner")),
            button("Audit de sécurité (Lynis)", lambda: terminal("ixin-secure audit")),
            button("Analyse antivirus du dossier personnel", lambda: terminal("ixin-secure scan")),
            button("Recherche de rootkits", lambda: terminal("ixin-secure rootkit")),
            button("Rapport complet (terminal)", lambda: terminal("ixin-secure status")),
        ]))
        v.addStretch(1)
        return w

    # ── Jeux ──
    def gaming_tab(self):
        w = QWidget()
        v = QVBoxLayout(w)
        v.setContentsMargins(28, 24, 28, 24)
        h = QLabel("Jeux")
        h.setObjectName("title")
        v.addWidget(h)
        tip = QLabel("Astuce Steam : Propriétés du jeu → Options de lancement →  "
                     "<b>ixin-gaming %command%</b>  (GameMode + MangoHud).<br>"
                     "Activez Proton pour tous les jeux : Steam → Paramètres → Compatibilité.")
        tip.setWordWrap(True)
        tip.setObjectName("sub")
        v.addWidget(tip)
        v.addSpacing(8)
        v.addWidget(grid([
            button("Steam", lambda: launch("steam"), True),
            button("Heroic (Epic, GOG, Amazon)", lambda: launch("heroic")),
            button("Lutris", lambda: launch("lutris")),
            button("Bottles (applications Windows)", lambda: launch("bottles")),
            button("ProtonUp-Qt (installer Proton-GE)", lambda: launch("protonup-qt")),
            button("Profil énergie : Performance", lambda: launch("powerprofilesctl", "set", "performance")),
            button("Profil énergie : Équilibré", lambda: launch("powerprofilesctl", "set", "balanced")),
            button("Paramètres NVIDIA", lambda: launch("nvidia-settings")),
        ]))
        v.addSpacing(14)
        anti = QLabel("<b>Jeux dont l'anti-triche exige Windows</b> (Valorant, Fortnite, certains Call of Duty, "
                      "Rainbow Six Siege…) : ils ne fonctionnent sur aucun système Linux. Avec Windows installé à côté "
                      "d'IXIN OS, un clic redémarre directement sur Windows, avec Secure Boot et l'anti-triche intacts ; "
                      "au redémarrage suivant, vous revenez sur IXIN OS. Pour vérifier un jeu : protondb.com.")
        anti.setWordWrap(True)
        anti.setObjectName("sub")
        v.addWidget(anti)
        has_windows = subprocess.run(["ixin-windows", "--check"], capture_output=True).returncode == 0 \
            if shutil.which("ixin-windows") else False
        play = button("Jouer sous Windows (Valorant, Fortnite…)", lambda: launch("ixin-windows"), has_windows)
        play.setEnabled(has_windows and not IS_LIVE)
        if not has_windows:
            play.setToolTip("Windows n'est pas installé sur ce PC")
        v.addWidget(grid([
            play,
            button("Vérifier un jeu (protondb.com)", lambda: QDesktopServices.openUrl(QUrl("https://www.protondb.com"))),
        ]))
        v.addStretch(1)
        return w

    # ── Système ──
    def system_tab(self):
        w = QWidget()
        v = QVBoxLayout(w)
        v.setContentsMargins(28, 24, 28, 24)
        h = QLabel("Système")
        h.setObjectName("title")
        v.addWidget(h)
        v.addWidget(grid([
            button("Mises à jour (système, Flatpak)", self.show_updates, True),
            button("Logithèque (Discover / Flathub)", lambda: launch("plasma-discover")),
            button("Instantanés système (Timeshift)", lambda: launch("timeshift-launcher")),
            button("Gestionnaire de partitions", lambda: launch("partitionmanager")),
            button("Paramètres du système", lambda: launch("systemsettings")),
            button("Moniteur système", lambda: launch("plasma-systemmonitor")),
            button("Nettoyage du disque (BleachBit)", lambda: launch("bleachbit")),
            button("Journal système", lambda: launch("ksystemlog")),
        ]))
        v.addStretch(1)
        return w


def from_windows():
    """Système live démarré par IXIN OS Setup (installation lancée depuis Windows)."""
    try:
        return "ixin.setup=windows" in Path("/proc/cmdline").read_text().split()
    except OSError:
        return False


def main():
    # Une erreur inattendue est affichée dans le journal au lieu de fermer le Centre IXIN.
    sys.excepthook = lambda t, e, tb: sys.stderr.write("".join(traceback.format_exception(t, e, tb)))
    welcome = "--welcome" in sys.argv
    if welcome and NO_WELCOME.exists():
        return 0
    if welcome and IS_LIVE and from_windows():
        return 0   # live lancé par IXIN OS Setup : son propre accueil (ixin-setup-windows) s'affiche seul
    tab = "home"
    if "--tab" in sys.argv[:-1]:
        tab = sys.argv[sys.argv.index("--tab") + 1]
    app = QApplication(sys.argv)
    app.setDesktopFileName("ixin-center")
    app.setStyleSheet(STYLE)
    win = Center(welcome, tab)
    win.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
